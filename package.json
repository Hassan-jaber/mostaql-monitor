{
  "name": "mostaql-monitor",
  "version": "2.1.0",
  "description": "Mostaql Front-End Project Monitor — no AI required",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "setup": "npx playwright install chromium"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "playwright": "^1.60.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^9.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "ts-node-dev": "^2.0.0"
    
  }
}
