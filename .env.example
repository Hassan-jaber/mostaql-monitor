# ═══════════════════════════════════════════════
#  Mostaql Monitor — Configuration
# ═══════════════════════════════════════════════

# ── Telegram (REQUIRED) ─────────────────────────
# Step 1: Message @BotFather on Telegram → /newbot
# Step 2: Copy the token it gives you
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIjklMnoPqrsTuvwXyz

# Your chat ID — message @userinfobot to get it
# For groups: add bot to group, message @getmyid_bot
TELEGRAM_CHAT_ID=123456789

# ── Monitoring ──────────────────────────────────
# Check interval in seconds (minimum 30, default 60)
CHECK_INTERVAL_SECONDS=60

# ── Server ──────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database & Logs ─────────────────────────────
DB_PATH=./data/mostaql.db
LOG_LEVEL=info
LOG_DIR=./logs

# ── AI — NOT USED ───────────────────────────────
# Leave blank. The system works WITHOUT any AI.
# Notifications fire on keyword match only.
AI_PROVIDER=none
AI_API_KEY=
