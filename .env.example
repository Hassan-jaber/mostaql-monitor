# ═══════════════════════════════════════
#  Mostaql Monitor — Environment Variables
# ═══════════════════════════════════════

# ── Server ──────────────────────────────
PORT=3001
NODE_ENV=production

# ── Telegram (REQUIRED) ─────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=123456789

# ── Monitoring ──────────────────────────
CHECK_INTERVAL_SECONDS=60

# ── Database ────────────────────────────
DB_PATH=./data/mostaql.db

# ── Logging ─────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
